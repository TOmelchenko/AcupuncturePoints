# Copy to .env and fill in real values. Never commit .env.
# Placeholders only — no real credentials in this file.

# Supabase (backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Amazon Bedrock (backend only, never exposed to the frontend)
AWS_REGION=replace-me
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Frontend (public values only — VITE_ variables are bundled into the browser app)
# Leave VITE_API_BASE_URL empty locally: the Vite dev server proxies /api to the backend.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me
