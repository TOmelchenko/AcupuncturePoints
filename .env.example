# Copy to .env and fill in real values. Never commit .env.
# Placeholders only — no real credentials in this file.

# Supabase (backend). Local defaults come from `make supabase-start` / `npx supabase status`.
# Access tokens are verified against SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Amazon Bedrock (backend and ingestion only, never exposed to the frontend)
# AI_PROVIDER=fake runs offline with deterministic fake embeddings and responses.
AI_PROVIDER=bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
BEDROCK_TEXT_MODEL_ID=anthropic.claude-opus-5-5
# Must match the vector(1024) column; changing it requires re-ingesting all sources.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Frontend (public values only — VITE_ variables are bundled into the browser app)
# Leave VITE_API_BASE_URL empty locally: the Vite dev server proxies /api to the backend.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me

# Database (backend and SQL scripts). Local default from `make supabase-start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
