# Copy to .env and fill in real values. Never commit .env.
# Placeholders only — no real credentials in this file.

# Supabase (backend). Local defaults come from `make supabase-start` / `npx supabase status`.
# Access tokens are verified against SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-me
# Optional: browser-facing Supabase URL for Storage image links (defaults to SUPABASE_URL).
# SUPABASE_PUBLIC_URL=

# AI provider (backend and ingestion only, never exposed to the frontend):
# `anthropic` (Claude API + Voyage AI embeddings), `bedrock` (Amazon Bedrock), or
# `fake` (offline, deterministic fake embeddings and responses).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_TEXT_MODEL_ID=claude-haiku-4-5
VOYAGE_API_KEY=replace-me
# Must return 1024 dimensions; changing it requires re-ingesting all sources.
VOYAGE_EMBEDDING_MODEL_ID=voyage-3.5

# Amazon Bedrock (only with AI_PROVIDER=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
BEDROCK_TEXT_MODEL_ID=anthropic.claude-opus-5-5
# Must match the vector(1024) column; changing it requires re-ingesting all sources.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Frontend (public values only — VITE_ variables are bundled into the browser app)
# Leave VITE_API_BASE_URL empty locally: the Vite dev server proxies /api to the backend.
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me

# Database (backend and SQL scripts). Local default from `make supabase-start`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Optional backend settings.
# LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API (only if not same-origin).
# CORS_ALLOWED_ORIGINS=
# Frontend host name; https://<host> is added to the allowed origins.
# FRONTEND_HOST=

# Optional, Docker Compose only: how the backend container reaches Supabase
# (defaults to the host's local Supabase via host.docker.internal).
# COMPOSE_SUPABASE_URL=
# COMPOSE_DATABASE_URL=
